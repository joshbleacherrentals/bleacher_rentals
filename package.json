{
  "name": "bleacher_rentals",
  "version": "1.12.0",
  "private": true,
  "scripts": {
    "generate-types-staging": "supabase gen types typescript --project-id \"sycrvbdpdbaczyfdwcnc\" --schema public > database.types.ts",
    "generate-types-local": "supabase gen types typescript --local --schema public > database.types.ts",
    "gtl": "npm run generate-types-local",
    "generate:events": "tsx scripts/generate-sample-events.mts",
    "simulate:payment": "tsx scripts/simulate-payment.mts",
    "postinstall": "powersync-web copy-assets -o public",
    "dev": "next dev",
    "dev:tunnel:josh": "concurrently \"next dev\" \"ngrok http --url=up-marmot-tops.ngrok-free.app 3000\"",
    "dev:tunnel:max": "concurrently \"next dev\" \"ngrok http --url=relapsing-mandolin-flatbed.ngrok-free.dev 3000\"",
    "dev:e2e": "next dev -p 3000",
    "check-deprecated": "tsx scripts/check-deprecated-db.mts",
    "prebuild": "npm run check-deprecated",
    "build": "next build",
    "start": "next start",
    "lint": "npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:db": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/driver-scorecard.test.sql",
    "test:db:fuzz": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/driver-scorecard.fuzz.sql",
    "test:db:damage": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/damage_reports_photos_uploaded.test.sql",
    "test:db:payments": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/manual_payment_entry.test.sql",
    "test:db:all": "npm run test:db && npm run test:db:fuzz && npm run test:db:damage && npm run test:db:swap && npm run test:db:survey && npm run test:db:payments && npm run test:db:tax && npm run test:db:qty && npm run test:db:inspections && npm run test:db:maintainer && npm run test:db:fixed && npm run test:db:acks && npm run test:db:worktrackertypes && npm run test:db:pickupdropofftime && npm run test:db:worktrackertypeswrites && npm run test:db:withdrawal",
    "test:e2e": "set -a && source .env.local && set +a && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright test src/features/manageTeam/e2e/auth.setup.ts --headed --project=chromium",
    "type-check": "tsc --noEmit",
    "tc": "npm run type-check",
    "cron:alerts": "set -a && source .env.local && set +a && curl -s -X GET http://localhost:3000/api/cron/alerts -H \"Authorization: Bearer $CRON_SECRET\" | cat",
    "test:db:withdrawal": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/worktracker_withdrawal.test.sql",
    "test:db:swap": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/actual_bleacher.test.sql",
    "test:db:tax": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/driver_tax_dec.test.sql",
    "test:db:qty": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/work_tracker_line_item_qty_decimal.test.sql",
    "test:db:inspections": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/bleacher_annual_inspections.test.sql",
    "test:db:maintainer": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/maintainer_role.test.sql",
    "test:db:fixed": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/damage_reports_fixed_by_driver.test.sql",
    "test:db:acks": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/damage_report_acknowledgements.test.sql",
    "test:db:worktrackertypes": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/work_tracker_type_codes.test.sql",
    "test:db:pickupdropofftime": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/work_tracker_pickup_dropoff_time.test.sql",
    "test:db:worktrackertypeswrites": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/work_tracker_types_admin_only_writes.test.sql",
    "preflight:sign": "tsx scripts/preflight/signPreflight.cli.ts"
  },
